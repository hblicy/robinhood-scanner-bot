# High-frequency discovery uses the Robinhood public RPC first.
DISCOVERY_RPC_URL=https://rpc.mainnet.chain.robinhood.com
DISCOVERY_RPC_CUPS=150

# Candidate analysis and whole-range discovery failover use this provider.
# Existing deployments may keep RPC_URL instead of ANALYSIS_RPC_URL.
# If both URLs normalize to the same endpoint, one provider uses the lower CUPS
# budget and never retries the same failed request as a fallback.
ANALYSIS_RPC_URL=
RPC_URL=
ANALYSIS_RPC_CUPS=250
DISCOVERY_RPC_COOLDOWN_MS=60000

# Telegram alerts (create a bot via @BotFather, then get chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Checklist filters (from the jiamigou article)
MAX_AGE_MINUTES=30
MIN_LIQUIDITY_USD=1500
MAX_MCAP_USD=1500000
# Deep V2 inspection starts at MIN_SCORE - 10. Local wallet-label bonuses (+5/+8)
# are applied only after that prefilter and never bypass confirmed sellability.
MIN_SCORE=55
MAX_TOP10_PCT=55
MAX_TAX_BPS=500
MAX_DEPLOYER_TOKENS=8
REQUIRE_SOCIAL=false
QUOTE_TOKENS=WETH,ETH,USDG

# Pons V2 lifecycle rules
LINE_A_MAX_AGE_MINUTES=20
LINE_A_IGNORE_SECONDS=10
MIN_FLOW_TRADES=5
MIN_FLOW_UNIQUE_TRADERS=3
MAX_SINGLE_TRADER_PCT=80
MAX_DEPLOYER_LAUNCHES_24H=20
HIGH_HEAT_LAUNCHES_24H=20000
WATCHLIST_CAP_NORMAL=3
WATCHLIST_CAP_HIGH_HEAT=1
CURVE_DEAD_GRACE_MS=14400000
PONS_CONFIRMATIONS=2
PONS_RECONCILE_INTERVAL_MS=60000
OUTBOX_POLL_MS=5000
DEXPAPRIKA_SCAN=true

# Discovery (booleans accept only true/false, 1/0, yes/no or on/off)
POLL_MS=2500
GECKO_POLL_MS=15000
ONCHAIN_SCAN=true
GECKO_SCAN=true
CONFIRMATION_BLOCKS=2
MAX_QUEUE_SIZE=500
MAX_SEEN_ENTRIES=10000
SEEN_TTL_MS=86400000

# Trusted stock/stable/native asset snapshots. Runtime refresh is used only when
# that chain manifest explicitly enables a verified HTTPS source.
ASSET_REFRESH_MS=21600000

# At least one discovery source must be enabled.
# QUOTE_TOKENS accepts WETH, ETH and USDG plus explicit 20-byte token addresses.

# Multi-chain EVM processes. Use official/public discovery endpoints. Configure
# all four analysis URLs with one dedicated Dwellir API key whose server-side
# monthly quota is 20,000,000 responses; other projects must use another key.
# A 429 pauses candidate deep inspection for 15 minutes while discovery continues.
# Each chain can still use an independent alert mode, score floor and chat.
# Robinhood keeps the legacy generic RPC_URL/ANALYSIS_RPC_URL compatibility above.
ETHEREUM_DISCOVERY_RPC_URL=https://ethereum-rpc.publicnode.com
ETHEREUM_ANALYSIS_RPC_URL=
ETHEREUM_ALERT_MODE=shadow
ETHEREUM_MIN_SCORE=70
ETHEREUM_CONFIRMATION_BLOCKS=12
ETHEREUM_MONTHLY_RPC_LIMIT=4500000
ETHEREUM_TELEGRAM_CHAT_ID=

BASE_DISCOVERY_RPC_URL=https://mainnet.base.org
BASE_ANALYSIS_RPC_URL=
BASE_ALERT_MODE=shadow
BASE_MIN_SCORE=70
BASE_CONFIRMATION_BLOCKS=2
BASE_MONTHLY_RPC_LIMIT=3000000
BASE_TELEGRAM_CHAT_ID=
# Base enables verified Stonks Exchange stock-pair discovery and strict pool/
# observed-sell binding. O1 stock pairs and BaseStonk stay disabled.

BSC_DISCOVERY_RPC_URL=https://bsc-dataseed.binance.org
BSC_ANALYSIS_RPC_URL=
BSC_ALERT_MODE=shadow
BSC_MIN_SCORE=70
BSC_CONFIRMATION_BLOCKS=3
BSC_MONTHLY_RPC_LIMIT=5500000
BSC_TELEGRAM_CHAT_ID=
# BSC enables verified Four.meme and Flap discovery. Their raw launch events are
# state-only; only resolved migration pools can enter launchpad security checks.

ROBINHOOD_DISCOVERY_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_ANALYSIS_RPC_URL=
ROBINHOOD_ALERT_MODE=live
ROBINHOOD_MIN_SCORE=70
ROBINHOOD_CONFIRMATION_BLOCKS=2
ROBINHOOD_MONTHLY_RPC_LIMIT=5000000
ROBINHOOD_TELEGRAM_CHAT_ID=
# Robinhood enables verified O1 plus the Pons V2 lifecycle scanner. Pons V1 and
# Long stay disabled because a verified event/contract identity is unavailable.

# Solana is a separate runtime. WebSocket is optional; HTTP reconciliation is
# always the completeness source. Keep shadow until operational acceptance.
# xStocks are loaded from the verified local snapshot; refresh them manually
# with `npm run refresh-assets -- xstocks`. Stonk Fun's independent identity
# stays disabled until an official Program ID and IDL are published.
SOLANA_DISCOVERY_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_ANALYSIS_RPC_URL=
SOLANA_WS_RPC_URL=
SOLANA_DISCOVERY_RPC_CUPS=40
SOLANA_ANALYSIS_RPC_CUPS=80
SOLANA_RPC_CONCURRENCY=4
SOLANA_DISCOVERY_RPC_COOLDOWN_MS=60000
SOLANA_POLL_MS=5000
SOLANA_ALERT_MODE=shadow
SOLANA_MIN_SCORE=70
SOLANA_MEANINGFUL_SELLER_COUNT=3
SOLANA_TELEGRAM_CHAT_ID=
