# Robinhood Chain RPC (public is rate-limited; Alchemy/QuickNode recommended for 24/7)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Telegram alerts (create a bot via @BotFather, then get chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# watch = alerts only (recommended)
# paper = alerts + simulated buys / TP-SL
# live  = real swaps; also requires ENABLE_LIVE_TRADING=true
MODE=watch

# Checklist filters (from the jiamigou article)
MAX_AGE_MINUTES=30
MIN_LIQUIDITY_USD=1500
MAX_MCAP_USD=1500000
MIN_SCORE=55
MAX_TOP10_PCT=55
MAX_TAX_BPS=500
MAX_DEPLOYER_TOKENS=8
REQUIRE_SOCIAL=false
QUOTE_TOKENS=WETH,ETH,USDG

# Discovery (intervals, block count and limits must be positive integers)
POLL_MS=2500
LOOKBACK_BLOCKS=120
GECKO_POLL_MS=15000
ONCHAIN_SCAN=true
GECKO_SCAN=true
MAX_QUEUE_SIZE=500
MAX_SEEN_ENTRIES=10000
SEEN_TTL_MS=86400000

# Experimental live gate. Current scanner fails closed until a trustworthy full
# Router buy-approve-sell simulation is implemented, so incomplete reports cannot trade.
ENABLE_LIVE_TRADING=false
PRIVATE_KEY=
# Fixed positive ETH decimal amounts, not a percentage of wallet value.
BUY_AMOUNT_ETH=0.01
MAX_BUY_ETH=0.03
SLIPPAGE_BPS=1200
GAS_LIMIT=450000

# Take-profit / stop-loss (article: 2x sell 30%, 5x sell 30%, 10x rest; -50% stop)
TP1_MULT=2
TP1_SELL_PCT=30
TP2_MULT=5
TP2_SELL_PCT=30
TP3_MULT=10
SL_PCT=50
POSITION_POLL_MS=8000
