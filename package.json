{
  "name": "robinhood-scanner-bot",
  "version": "1.0.0",
  "description": "Robinhood Chain memecoin scanner + Telegram alert bot (jiamigou checklist)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js watch",
    "watch": "node src/index.js watch",
    "watch:robinhood": "node src/index.js watch --chain robinhood",
    "watch:base": "node src/index.js watch --chain base",
    "watch:bsc": "node src/index.js watch --chain bsc",
    "watch:ethereum": "node src/index.js watch --chain ethereum",
    "watch:solana": "node src/index.js watch --chain solana",
    "scan": "node src/index.js scan",
    "check": "node src/index.js check",
    "import-wallets": "node scripts/import-wallet-csv.js",
    "refresh-assets": "node scripts/refresh-asset-catalog.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^4.0.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5"
  },
  "overrides": {
    "rpc-websockets": "9.2.0"
  }
}
